# Application
NODE_ENV=development
APP_PORT=3000
LOG_LEVEL=log

# MySQL 8
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=app_user
MYSQL_PASSWORD=replace-me
MYSQL_DATABASE=mediconcen_code_test
MYSQL_POOL_SIZE=10
MYSQL_LOGGING=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty when Redis has no password (the provided docker-compose.yml does not set one).
REDIS_PASSWORD=
# Seconds an entry stays cached. Set 0 to disable caching (MySQL only).
USER_ID_CACHE_TTL_SECONDS=3600
USER_ID_CACHE_KEY_PREFIX=v1:user-id-mapping
